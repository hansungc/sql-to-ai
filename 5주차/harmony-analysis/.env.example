# Claude Code를 시작하거나 자동 실행할 때 필요한 로컬 값입니다.
DB_PASSWORD='readonly_account.sql.local에_적은_비밀번호'
RECORDER_PASSWORD='recorder_account.sql.local에_적은_비밀번호'
# 환경셋업/.env와 같은 포트. 3306 충돌 시 두 파일 모두 예: 13306
HARMONY_DB_PORT=3306

# cron에서 PATH가 짧을 때만 실제 경로를 적습니다.
# macOS/Linux: command -v claude, dirname "$(command -v npx)"로 확인합니다.
CLAUDE_BIN='/실제/경로/claude'
NODE_BIN_DIR='/실제/node와_npx가_있는_폴더'
